<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ (API 33+) video permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 14+ (API 34+) partial visual media selection support -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Android 12 (API 31-32) storage permission -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Cloud tab: TDLib talks to Telegram over the network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Frosted Jelly haptics: the knock a pressed control answers with -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keeping a film: the row that says how far it has come, and the ask for it on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        A download is kept alive by a foreground service, because nothing else on Android guarantees that
        a process with no visible screen survives long enough to finish a four gigabyte file. The type is
        dataSync — it is moving bytes and playing nothing — and on Android 14+ naming it is not optional.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Keeps the link alive when the screen goes off mid-download, until the last film lands -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The settings row that asks the system to stop putting this app to sleep -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The updater fetches a signed release and hands it to the installer, which is the one thing on
         Android that still needs asking about rather than merely declaring. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ArcPlayerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArcPlayer">
        <!-- Everything that can shift while a film is running is handled in place rather than by a
             relaunch: a recreated activity loses the open playback, so the player closes on its own. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Not exported: it exists only while this app is fetching a film, and nothing outside the
             process has any business starting it. -->
        <service
            android:name=".cloud.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
